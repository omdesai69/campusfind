pe:disc;font-size:12pt;font-family:Roboto,sans-serif;color:#4d5156;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;\" aria-level=\"1\"\u003e\u003cp dir=\"ltr\" style=\"line-height:1.5;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt;\" role=\"presentation\"\u003e\u003cspan style=\"font-size:12pt;font-family:Roboto,sans-serif;color:#4d5156;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003e150+ marks = \u003c/span\u003e\u003cspan style=\"font-size:12pt;font-family:Roboto,sans-serif;color:#4d5156;background-color:transparent;font-weight:700;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003e99+ percentile\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli dir=\"ltr\" style=\"list-style-type:disc;font-size:12pt;font-family:Roboto,sans-serif;color:#4d5156;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;\" aria-level=\"1\"\u003e\u003cp dir=\"ltr\" style=\"line-height:1.5;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt;\" role=\"presentation\"\u003e\u003cspan style=\"font-size:12pt;font-family:Roboto,sans-serif;color:#4d5156;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003eHighly competitive for \u003c/span\u003e\u003cspan style=\"font-size:12pt;font-family:Roboto,sans-serif;color:#4d5156;background-color:transparent;font-weight:700;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003etop pharmacy colleges\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli dir=\"ltr\" 