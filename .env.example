# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)
CORS_ORIGIN=              # Frontend URL allowed to call the backend, e.g. https://your-app.vercel.app

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgresql://user:pass@host:5432/db)

# ── Frontend ────────────────────────────────────────────────────
VITE_API_URL=             # Backend URL for deployed frontend, e.g. https://your-api.railway.app
